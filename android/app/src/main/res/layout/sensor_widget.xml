<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp"
    android:background="#B3202020">

    <!-- ========== ЭКРАН 1: КОМНАТА ========== -->
    <LinearLayout
        android:id="@+id/screen_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Строка 1: Заголовок + время + кнопка обновления -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Комната"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/time_room"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="14:30"
                android:textColor="#BDBDBD"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />

            <!-- Кнопка обновления с анимацией -->
            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="20dp">

                <ImageButton
                    android:id="@+id/btn_refresh_room"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_popup_sync"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:contentDescription="Обновить"
                    android:clickable="true"
                    android:focusable="true" />

                <ProgressBar
                    android:id="@+id/progress_room"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Строка 2: Температура и Влажность (вместе) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/temp_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25.6°C"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/humidity_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  48.0%"
                android:textSize="20sp"
                android:textColor="#E0E0E0"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== ЭКРАН 2: УЛИЦА / БАЛКОН ========== -->
    <LinearLayout
        android:id="@+id/screen_outside"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Строка 1: Заголовок + время + кнопка обновления -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Улица/Балкон"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/time_street"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="14:30"
                android:textColor="#BDBDBD"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />

            <!-- Кнопка обновления с анимацией -->
            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="20dp">

                <ImageButton
                    android:id="@+id/btn_refresh_outside"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_popup_sync"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:contentDescription="Обновить"
                    android:clickable="true"
                    android:focusable="true" />

                <ProgressBar
                    android:id="@+id/progress_outside"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Строка 2: Температура улицы и балкона (вместе) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/temp_street"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15.2°C"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/temp_balcony"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  18.5°C"
                android:textSize="20sp"
                android:textColor="#E0E0E0"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>